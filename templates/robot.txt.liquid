{%- comment -%}
  Groupes par défaut Shopify (Googlebot + autres bots principaux)
  On les laisse à la fin pour compatibilité maximale.
{%- endcomment -%}
{% for group in robots.default_groups %}
  {{- group.user_agent -}}

  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}
