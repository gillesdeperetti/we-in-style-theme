{%- comment -%}
  WE IN STYLE - robots.txt.liquid
  Principe : on garde les règles par défaut de Shopify (maintenues et mises à jour
  automatiquement, déjà adaptées aux agents IA), on bloque seulement les scrapers
  agressifs, et on ajoute le blocage shopifybooster au groupe "*".
  Tous les bots IA utiles (Googlebot, Google-Extended, Bingbot, Meta-WebIndexer,
  Meta-ExternalFetcher, GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot, Applebot...)
  suivent le groupe "*" : pages produits, collections, blogs ET politiques accessibles,
  zones transactionnelles bloquées.
{%- endcomment -%}

# --------------------------------------------------------------------
#  SCRAPERS AGRESSIFS -> BLOQUÉS
# --------------------------------------------------------------------
User-agent: PetalBot
Disallow: /

User-agent: Bytespider
Disallow: /

User-agent: Baiduspider
Disallow: /

User-agent: YisouSpider
Disallow: /

User-agent: CCBot
Disallow: /

# --------------------------------------------------------------------
#  OPTIONNEL : refuser l'entraînement des modèles Meta
#  (sans impact sur les citations Meta AI, gérées par Meta-WebIndexer)
#  Décommenter les 2 lignes ci-dessous pour activer.
# --------------------------------------------------------------------

User-agent: meta-externalagent
Disallow: /

# --------------------------------------------------------------------
#  GROUPES PAR DÉFAUT SHOPIFY (+ ajout shopifybooster au groupe "*")
# --------------------------------------------------------------------
{% for group in robots.default_groups %}
  {{- group.user_agent }}

  {%- for rule in group.rules -%}
    {{ rule }}
  {%- endfor -%}

  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /*shopifybooster' }}
  {%- endif -%}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}
