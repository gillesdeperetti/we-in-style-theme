radient_direction":"to top","link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_kqbWnm":{"type":"text","name":"t:names.heading","settings":{"text":"<p>Refined Minimalism for Modern Evenings<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_HPGpFU":{"type":"text","settings":{"text":"<p>For those who prefer to ring in the New Year in quietly luxurious style, minimal silhouettes and elevated fabrics offer a timeless alternative to sequins and sparkle. Think clean lines, subtle details, and a focus on impeccable fit.<\/p><p>The <a href=\"\/products\/asymmetrical-black-evening-gown-women\">Asymmetrical Black Evening Gown<\/a> by Versace is a masterclass in modern elegance. With its one-shoulder neckline, body-hugging viscose-nylon blend, and concealed zip, it sculpts the figure without shouting for attention, just add sculptural earrings and a sleek sandal, and you’re done.<\/p><p>Khaite’s dresses are ideal for a more understated, gallery-opening kind of New Year’s Eve. The <a href=\"\/products\/yael-dress-khaite-women-bleu-fonce\">Yael Dress<\/a> in navy crêpe skims the body with a long silhouette and integrated bustier that feels both supportive and refined. For a softer, airier take, the <a href=\"\/products\/mellie-beige-dress-khaite-women\">Mellie Beige Dress<\/a> in silk organza features a relaxed, trapeze shape with a deep V-neck and open back: perfect for intimate dinners or warm-climate celebrations where ease is essential.<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"image_NM49n6":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/27382793_58895141_1000.webp","link":"shopify:\/\/products\/yael-dress-khaite-women-bleu-fonce","image_ratio":"adapt","width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fill","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_mWjjTE":{"type":"text","settings":{"text":"<p>Keep accessories within the same minimalist language: fine gold or silver jewelry, neutral heels, and a structured mini bag. A polished blowout or low chignon and a soft, diffused smokey eye complete this quietly luxurious NYE aesthetic.<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_kqbWnm","text_HPGpFU","image_NM49n6","text_mWjjTE"]}},"block_order":["image_MEhPmV","group_waYYfm"],"name":"t:names.image_with_text","settings":{"content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"flex-start","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":32,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":40,"padding-block-end":40}},"section_9Pmihe":{"type":"section","blocks":{"image_bhBytL":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/27382741_58888053_1000.webp","link":"shopify:\/\/products\/mellie-beige-dress-khaite-women","image_ratio":"portrait","width":"custom","custom_width":70,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"group_Rb8nLz":{"type":"group","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"width":"custom","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fill","custom_height":100,"inherit_color_scheme":true,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_giXzik":{"type":"text","name":"t:names.heading","settings":{"text":"<p>Ring In the New Year in Your Signature Style<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_Hh36Jb":{"type":"text","settings":{"text":"<p>Whether you’re drawn to edgy silhouettes from Diesel and Christopher Esber, craving the high-voltage glamour of Rabanne’s metallics and lace, or leaning into the minimalist elegance of Khaite and Versace, your New Year’s Eve outfit sets the tone for the year ahead. Explore our selections and find the piece that feels like your next chapter. When midnight hits, you’ll be ready.<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_giXzik","text_Hh36Jb"]}},"block_order":["image_bhBytL","group_Rb8nLz"],"name":"t:names.image_with_text","settings":{"content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"flex-start","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":32,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":40,"padding-block-end":40}},"section_KWNT9f":{"type":"section","blocks":{"text_QAJV3L":{"type":"text","name":"t:names.heading","settings":{"text":"<h3>Frequently asked questions<\/h3>","width":"fit-content","max_width":"narrow","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"accordion_pN8P8b":{"type":"accordion","name":"t:names.accordion","settings":{"enable_faq_schema":true,"icon":"caret","dividers":true,"type_preset":"h5","inherit_color_scheme":true,"color_scheme":"","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"accordion_row_8WP7ah":{"type":"_accordion-row","settings":{"heading":"How can I stay warm in a sheer or lace New Year’s Eve dress?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_CXWMgi":{"type":"text","settings":{"text":"<p>Layering is key. For sheer and lace styles like the <a href=\"\/products\/black-lace-long-dress-rabanne-women\">Black Lace Long Dress<\/a> or the <a href=\"\/products\/floral-lace-short-dress-rabanne-women-15546867941756\">Floral Lace Short Dress<\/a>, start with a sleek, skin-tone slip or bodysuit to add warmth without disrupting the design. Add sheer black tights, a tailored wool coat, and heeled boots or closed-toe pumps. You can also drape a faux-fur stole or scarf over your shoulders for extra insulation while still looking dressy.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_CXWMgi"]},"accordion_row_gcxmnq":{"type":"_accordion-row","settings":{"heading":"What should I wear if my New Year’s Eve invite says ‘cocktail attire’?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_fqTaEX":{"type":"text","settings":{"text":"<p>Cocktail attire calls for polished, party-ready dresses that aren’t quite black-tie. The <a href=\"\/products\/damami-dress-diesel-women-black\">D-Amami Dress<\/a> by Diesel or Rabanne’s <a href=\"\/products\/fringe-long-dress-rabanne-women-black\">Fringe Long Dress<\/a> both hit the sweet spot: elevated enough for a chic venue, but still fun and fashion-forward. Pair with mid-to-high heels, a compact evening bag, and considered jewelry. If you prefer minimalism, the <a href=\"\/products\/mellie-beige-dress-khaite-women\">Mellie Beige Dress<\/a> from Khaite styled with statement earrings also reads perfectly cocktail-appropriate.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_fqTaEX"]},"accordion_row_tPBLBi":{"type":"_accordion-row","settings":{"heading":"Which New Year’s Eve dress styles are the most comfortable for a long night out?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_jHJzxH":{"type":"text","settings":{"text":"<p>Look for fabrics with movement and cuts that don’t restrict you. Soft jersey and fluid crepe are ideal. The <a href=\"\/products\/asymmetrical-draped-dress-christopher-esber-women-15495056916860\">Asymmetrical Draped Dress<\/a> by Christopher Esber offers stretch and drape that move with you, while Khaite’s <a href=\"\/products\/yael-dress-khaite-women-bleu-fonce\">Yael Dress<\/a> in crêpe and <a href=\"\/products\/mellie-beige-dress-khaite-women\">Mellie Beige Dress<\/a> in silk organza skim the body without feeling tight. If you love shine but want comfort, opt for a more relaxed cut like Rabanne’s <a href=\"\/products\/sparkle-gold-dress-rabanne-women-15518545609084\">Sparkle Gold Dress<\/a>, which delivers impact while allowing ease of movement. Always pair with shoes you can realistically stand and dance in for several hours.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_jHJzxH"]}},"block_order":["accordion_row_8WP7ah","accordion_row_gcxmnq","accordion_row_tPBLBi"]}},"block_order":["text_QAJV3L","accordion_pN8P8b"],"name":"t:names.faq_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":32,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48}}},"order":["section","hero_V8Bi6A","section_NYF8dB","section_jRWEj7","section_e8htxn","section_eUDXmV","section_hJtGkk","section_9Pmihe","section_KWNT9f"]}