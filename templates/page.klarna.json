              ]
            },
            "accordion_row_FcF9fc": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Will Klarna perform a credit check for 3 interest-free installments?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_etRxWg": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>When you choose to pay using Klarna’s 3 interest-free installments, Klarna may request a credit report from a third-party credit bureau as part of their assessment process. The inquiry is typically a soft check, meaning it should not impact your credit score, but it is still important to be aware that Klarna may review certain financial information before approving your purchase.</p>",
                    "width": "100%",
