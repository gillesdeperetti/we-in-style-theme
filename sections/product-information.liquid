{% comment %} [CUSTOM-GILLES] Filtrage Marque et redirection {% endcomment %}
{% render 'brand-access-control', product: closest.product %}
{% comment %} [CUSTOM-GILLES] Fin filtrage Marque et redirection {% endcomment %}

{% liquid
  if section.settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  assign product_has_media = true
  if closest.product.media.size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif section.settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if section.settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if section.settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  case section.settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

{% comment %} [CUSTOM-GILLES]   Schema JSON LD - Product {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ product.title | strip_html | escape }}",
  "url": "{{ shop.url }}{{ product.url }}",
  "sku": "{{ product.selected_or_first_available_variant.sku }}",
  "brand": {
    "@type": "Brand",
    "name": "{{ product.vendor | escape }}"
  },
  "inProductGroupWithID": "{{ product.metafields.global.reference | default: product.id | replace: ' ', '-' | replace: '/', '-' | replace: '_', '-' | truncate: 50 | escape }}",
  "category": "{{ product.metafields.custom.categories | escape }}",
  "description": {{ product.description | strip_html | default: "Product description not available" | json }},
  "image": [
    "https:{{ product.featured_image.src | image_url }}"
    {% for image in product.images offset: 1 limit: 2 %}
    , "https:{{ image | image_url }}"
    {% endfor %}
  ],
  "keywords": {{ product.featured_image.alt | json }}

  {%- assign dim_obj = product.metafields.custom.product_dimensions.value -%}
  
  {%- if dim_obj -%}
    {%- assign raw_h = dim_obj.height_cm.value | default: dim_obj.height_cm -%}
    {%- assign raw_l = dim_obj.length_cm.value | default: dim_obj.length_cm -%}
    {%- assign raw_w = dim_obj.width_cm.value | default: dim_obj.width_cm -%}
    {%- assign raw_d = dim_obj.depth_cm.value | default: dim_obj.depth_cm -%}

    {%- assign final_h = raw_h -%}
    {%- assign final_l = raw_l -%}
    {%- assign final_w = raw_w -%}

    {%- if final_l == blank and raw_w != blank and raw_d != blank -%}
      {%- assign final_l = raw_w -%}
      {%- assign final_w = raw_d -%}
    {%- elsif final_w == blank and raw_d != blank -%}
      {%- assign final_w = raw_d -%}
    {%- endif -%}

    {%- assign final_w = final_w | downcase | remove: 'cm' | remove: 'mm' | replace: ',', '.' | strip -%}
    {%- assign final_h = final_h | downcase | remove: 'cm' | remove: 'mm' | replace: ',', '.' | strip -%}
    {%- assign final_l = final_l | downcase | remove: 'cm' | remove: 'mm' | replace: ',', '.' | strip -%}

    {%- if final_w != blank -%}
    , "width": {
      "@type": "QuantitativeValue",
      "value": {{ final_w | plus: 0 }},
      "unitCode": "CMT"
    }
    {%- endif -%}
    {%- if final_h != blank -%}
    , "height": {
      "@type": "QuantitativeValue",
      "value": {{ final_h | plus: 0 }},
      "unitCode": "CMT"
    }
    {%- endif -%}
    {%- if final_l != blank -%}
    , "depth": {
      "@type": "QuantitativeValue",
      "value": {{ final_l | plus: 0 }},
      "unitCode": "CMT"
    }
    {%- endif -%}
  {%- endif -%}

  {%- assign comp_list = product.metafields.custom.composition.value -%}
  {%- if comp_list -%}
    {%- capture material_string -%}
      {%- for item in comp_list -%}
        {{ item.name }}{% unless forloop.last %}, {% endunless %}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if material_string != blank -%}
    , "material": {{ material_string | strip | json }}
    {%- endif -%}
  {%- endif -%}

  {% assign season_raw = product.metafields.custom.saison %}
  {% assign season_prefix = '' %}
  {% assign season_year2 = '' %}
  {% assign season_year4 = '' %}
  {% assign season_code = '' %}
  {% assign season_label = '' %}

  {% if season_raw %}
    {% assign raw_up = season_raw | upcase %}
    {% for j in (0..99) %}
      {% if season_year2 == '' and season_prefix == '' %}
        {% assign jj = j | prepend: '0' | slice: -2, 2 %}
        {% assign token_p = 'P' | append: jj %}
        {% assign token_h = 'H' | append: jj %}
        {% if raw_up contains token_p %}
          {% assign season_prefix = 'SS' %}
          {% assign season_year2 = jj %}
        {% endif %}
        {% if season_year2 == '' and raw_up contains token_h %}
          {% assign season_prefix = 'FW' %}
          {% assign season_year2 = jj %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% if season_prefix == '' %}
      {% if season_raw contains 'Spring' or season_raw contains 'Summer' %}
        {% assign season_prefix = 'SS' %}
      {% elsif season_raw contains 'Fall' or season_raw contains 'Winter' %}
        {% assign season_prefix = 'FW' %}
      {% endif %}
    {% endif %}
    {% if season_year2 == '' %}
      {% for i in (1980..2099) %}
        {% assign y = i | append: '' %}
        {% if season_raw contains y %}
          {% assign season_year4 = y %}
          {% assign season_year2 = y | slice: 2, 2 %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if season_prefix != '' and season_year2 != '' %}
      {% assign season_code = season_prefix | append: season_year2 %}
      {% if season_year4 == '' %}
        {% assign season_year4 = '20' | append: season_year2 %}
      {% endif %}
      {% if season_prefix == 'FW' %}
        {% assign season_label = 'Fall Winter ' | append: season_year4 %}
      {% else %}
        {% assign season_label = 'Spring Summer ' | append: season_year4 %}
      {% endif %}
    {% endif %}
  {% endif %}

  {% assign props = '' %}
  {% assign season_display = season_label | default: season_raw %}
  {% if season_display %}
    {% assign props = props | append: '{ "@type": "PropertyValue", "name": "Season", "value": "' | append: season_display | append: '" }' %}
    {% if season_code %}
      {% assign props = props | append: ', { "@type": "PropertyValue", "name": "SeasonCode", "value": "' | append: season_code | append: '" }' %}
    {% endif %}
  {% endif %}

  {% if props != '' %}
  , "additionalProperty": [ {{ props }} ]
  {% endif %}

  {% if product.metafields.custom.fabrication %}
  , "countryOfOrigin": "{{ product.metafields.custom.fabrication | escape }}"
  {% endif %}

  , "audience": {
    "@type": "PeopleAudience",
    "suggestedGender": "{{ product.metafields.custom.genre.name | default: 'Unisex' }}",
    "suggestedMinAge": 13
  },

  "offers": [
  {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "priceCurrency": "{{ shop.currency }}",
      "price": "{{ variant.price | divided_by: 100.00 }}",
      "priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 | append: '-12-31' }}",
      "itemCondition": "NewCondition",
      "availability": "{% if variant.available %}InStock{% elsif variant.inventory_quantity == 0 and variant.incoming %}PreOrder{% else %}OutOfStock{% endif %}",
      "url": "{{ shop.url }}{{ product.url }}",
      "sku": "{{ variant.sku }}",
      {% if variant.barcode %}
        "gtin": "{{ variant.barcode }}",
      {% endif %}
      {% if variant.metafields.custom.mpn %}
        "mpn": "{{ variant.metafields.custom.mpn | escape }}",
      {% endif %}
      {% if variant.image %}
        "image": "https:{{ variant.image.src | image_url }}",
      {% elsif product.featured_image %}
        "image": "https:{{ product.featured_image.src | image_url }}",
      {% endif %}
      "name": "{{ product.title | strip_html | escape }}{% if variant.title != 'Default Title' %} - {{ variant.title | escape }}{% endif %}",
      "seller": {
        "@type": "OnlineStore",
        "name": "{{ shop.name | escape }}",
        "url": "{{ shop.url }}"
      },
      "availableDeliveryMethod": "https://schema.org/ParcelService",
      {% assign eu_countries = "AT,BE,BG,CY,CZ,DE,DK,EE,ES,FI,FR,GR,HR,HU,IE,IT,LT,LU,LV,MT,NL,PL,PT,RO,SE,SI,SK" | split: "," %}
      {% assign other_countries = "US,CA,KR,JP,CN,IN,AU,NZ,BR,MX,RU,AR,ZA,SA,TR,TH,SG,MY,VN,ID,AE" | split: "," %}
      {% assign shipping_json = "" %}
      {% assign rate_eu = "9.90" %}
      {% if variant.price > 30000 %}
        {% assign rate_eu = "0" %}
      {% endif %}
      {% for country in eu_countries %}
        {% if shipping_json != "" %}{% assign shipping_json = shipping_json | append: ", " %}{% endif %}
        {% assign shipping_json = shipping_json
          | append: '{ "@type": "OfferShippingDetails", "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "' 
          | append: country 
          | append: '" }, "shippingRate": { "@type": "MonetaryAmount", "value": "' 
          | append: rate_eu 
          | append: '", "currency": "' | append: shop.currency | append: '" }, "deliveryTime": { "@type": "ShippingDeliveryTime", "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "d" }, "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 5, "unitCode": "d" } } }' %}
      {% endfor %}
      {% assign rate_row = "19.90" %}
      {% if variant.price > 50000 %}
        {% assign rate_row = "0" %}
      {% endif %}
      {% for country in other_countries %}
        {% if shipping_json != "" %}{% assign shipping_json = shipping_json | append: ", " %}{% endif %}
        {% assign shipping_json = shipping_json
          | append: '{ "@type": "OfferShippingDetails", "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "' 
          | append: country 
          | append: '" }, "shippingRate": { "@type": "MonetaryAmount", "value": "' 
          | append: rate_row 
          | append: '", "currency": "' | append: shop.currency | append: '" }, "deliveryTime": { "@type": "ShippingDeliveryTime", "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "d" }, "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 5, "unitCode": "d" } } }' %}
     {% endfor %}
      "shippingDetails": [ {{ shipping_json }} ],
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": [
          "AT", "BE", "BG", "CY", "CZ", "DE", "DK", "EE", "ES", "FI", "FR", "GR", "HR", "HU", "IE", "IT", "LT", "LU", "LV", "MT", "NL", "PL", "PT", "RO", "SE", "SI", "SK",
          "US", "CA", "KR", "JP", "CN", "IN", "AU", "NZ", "BR", "MX", "RU", "AR", "ZA", "SA", "TR", "TH", "SG", "MY", "VN", "ID", "AE"
        ],
        "url": "{{ shop.url }}{% unless request.locale.iso_code == 'fr' %}/{{ request.locale.iso_code }}{% endunless %}/policies/refund-policy",
        "merchantReturnDays": 30,
        "returnFees": "ReturnFeesCustomerResponsibility",
        "returnMethod": "ReturnByMail",
        "returnPolicyCategory": "MerchantReturnFiniteReturnWindow"
      }
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ],

  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "applicableCountry": [
      "AT", "BE", "BG", "CY", "CZ", "DE", "DK", "EE", "ES", "FI", "FR", "GR", "HR", "HU", "IE", "IT", "LT", "LU", "LV", "MT", "NL", "PL", "PT", "RO", "SE", "SI", "SK",
      "US", "CA", "KR", "JP", "CN", "IN", "AU", "NZ", "BR", "MX", "RU", "AR", "ZA", "SA", "TR", "TH", "SG", "MY", "VN", "ID", "AE"
    ],
    "url": "{{ shop.url }}{% unless request.locale.iso_code == 'en' %}/{{ request.locale.iso_code }}{% endunless %}/policies/refund-policy",
    "merchantReturnDays": 30,
    "returnFees": "ReturnFeesCustomerResponsibility",
    "returnMethod": "ReturnByMail",
    "returnPolicyCategory": "MerchantReturnFiniteReturnWindow"
  }{% if review_count > 0 and review_value > 0 %},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ review_value }},
    "reviewCount": {{ review_count }},
    "bestRating": 5,
    "worstRating": 1
  }
  {% endif %}
}
</script>
{% comment %} [CUSTOM-GILLES]  FIN Schema JSON LD - Product {% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="product-information section section--{{ content_width }} spacing-style color-{{ section.settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: section.settings %} --gap: {{ section.settings.gap }}px;"
>
  {% if section.settings.desktop_media_position == 'left' and product_has_media %}
    {% assign product_href = '#ProductInformation-' | append: section.id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div
    class="{{ product_grid_class }}"
    data-product-grid-content
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {%- content_for 'block',
          type: '_product-media-gallery',
          id: 'media-gallery',
          closest.product: closest.product
        -%}
      </div>
    {% endcapture %}

    {% capture details %}
      {% content_for 'block',
        type: '_product-details',
        id: 'product-details',
        closest.product: closest.product
      %}
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ details }}
      {% endif %}
    {% endfor %}
  </div>

  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 2 / 3;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none,
    .product-information__grid:has(.product-information__media:empty) {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(:has(.product-information__media:empty)) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(:has(.product-information__media:empty)),
      .product-information__grid:not(:has(.product-information__media:empty)) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    max-width: var(--sidebar-width);
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
